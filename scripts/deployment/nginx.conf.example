# Template: replace domain, release path, PHP socket and certificate paths.
server {
    listen 80;
    server_name devflow.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name devflow.example.com;
    root /srv/devflow/current/public;
    index index.php;
    ssl_certificate /etc/letsencrypt/live/devflow.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devflow.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 2m;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }
    location /build/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
    }
}
