[Unit]
Description=DevFlow Reverb WebSocket server
After=network.target
[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/devflow/current
ExecStart=/usr/bin/php8.5 artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
[Install]
WantedBy=multi-user.target
